{
  "name": "@portfolio/content",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/testing.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ask": {
      "types": "./dist/ask.d.ts",
      "default": "./dist/ask.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "generate": "node src/cli.ts generate",
    "validate": "node src/cli.ts validate",
    "build": "node src/cli.ts generate && tsc -p tsconfig.build.json",
    "typecheck": "node src/cli.ts generate && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
