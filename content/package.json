{
  "name": "@portfolio/content",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node src/cli.ts generate",
    "validate": "node src/cli.ts validate",
    "build": "node src/cli.ts generate && tsc -p tsconfig.build.json",
    "typecheck": "node src/cli.ts generate && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
