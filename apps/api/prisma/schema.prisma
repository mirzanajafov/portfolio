generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model AskLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  createdAt  DateTime @default(now())
  visitor    String?
  question   String
  engine     String
  sentences  Json
  withheld   String[]
  refused    Boolean
  durationMs Int

  @@index([createdAt])
}

model Visit {
  visitor   String     @id
  startedAt DateTime
  device    String
  browser   String
  country   String?
  city      String?
  network   String?
  views     PageView[]

  @@index([startedAt])
}

model PageView {
  id            String        @id @db.Uuid
  createdAt     DateTime      @default(now())
  visitor       String
  visit         Visit         @relation(fields: [visitor], references: [visitor], onDelete: Cascade)
  path          String
  notFound      Boolean       @default(false)
  referrerHost  String?
  ref           String?
  readSeq       Int           @default(0)
  activeSeconds Int           @default(0)
  maxScroll     Int           @default(0)
  blocks        Json          @default("{}")
  lcpMs         Int?
  inpMs         Int?
  cls           Float?
  demo          String?
  actions       String[]      @default([])
  clicks        LinkClick[]
  errors        ClientError[]

  @@index([visitor])
  @@index([createdAt])
  @@index([ref])
}

model LinkClick {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  viewId    String   @db.Uuid
  view      PageView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  href      String

  @@index([viewId])
}

model ClientError {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  viewId    String   @db.Uuid
  view      PageView @relation(fields: [viewId], references: [id], onDelete: Cascade)
  message   String
  source    String
  line      Int?
  column    Int?

  @@index([viewId])
}

model VisitorSalt {
  day  DateTime @id @db.Date
  salt Bytes
}

model DroppedEvents {
  day    DateTime @db.Date
  reason String
  count  Int      @default(1)

  @@id([day, reason])
}

model DailyVisits {
  day          DateTime @id @db.Date
  visits       Int
  pageViews    Int
  phoneVisits  Int
  quickExits   Int
  visitSeconds Int[]
  openedDemo   Int      @default(0)
  didDemoStep  Int      @default(0)
}

model DailyPage {
  day           DateTime @db.Date
  path          String
  device        String
  views         Int
  visits        Int
  exits         Int
  notFoundViews Int
  activeSeconds Int[]
  maxScroll     Int[]
  blockSeconds  Json
  lcpMs         Int[]
  inpMs         Int[]
  cls           Float[]

  @@id([day, path, device])
}

model DailySource {
  day    DateTime @db.Date
  source String
  host   String
  visits Int

  @@id([day, source, host])
}

model DailyCountry {
  day     DateTime @db.Date
  country String
  visits  Int

  @@id([day, country])
}

model DailyClick {
  day    DateTime @db.Date
  path   String
  href   String
  clicks Int

  @@id([day, path, href])
}

model DailyDemo {
  day              DateTime @db.Date
  demo             String
  clicked          Int
  fromSite         Int
  clickedNotOpened Int
  demoOnly         Json
  didStep          Int
  steps            Json
  activeSeconds    Int[]

  @@id([day, demo])
}

model DailyApplication {
  day           DateTime    @db.Date
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  visits        Int
  views         Int

  @@id([day, applicationId])
  @@index([applicationId])
}

model Application {
  id          String              @id @default(uuid(7)) @db.Uuid
  code        String              @unique
  company     String
  role        String
  appliedOn   DateTime            @db.Date
  createdAt   DateTime            @default(now())
  country     String?
  city        String?
  atsHost     String?
  networks    String[]
  firstSeenOn DateTime?           @db.Date
  channel     ApplicationChannel
  cvVariant   String
  status      ApplicationStatus   @default(sent)
  answeredOn  DateTime?           @db.Date
  notes       String              @default("")
  days        DailyApplication[]
  changes     ApplicationChange[]
}

enum ApplicationChannel {
  referral
  direct
  recruiter
}

enum ApplicationStatus {
  sent
  screening
  interview
  offer
  accepted
  rejected
  withdrawn
}

enum ApplicationField {
  status
  channel
  cvVariant
  answeredOn
  notes
  company
  role
}

model ApplicationChange {
  id            Int              @id @default(autoincrement())
  applicationId String           @db.Uuid
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  at            DateTime
  field         ApplicationField
  before        String?
  after         String?
  undo          Boolean          @default(false)

  @@index([applicationId, id])
}

model Alert {
  id            String   @id @default(uuid(7)) @db.Uuid
  createdAt     DateTime @default(now())
  text          String
  attempts      Int      @default(0)
  nextAttemptAt DateTime

  @@index([nextAttemptAt])
}

model GivenUpAlerts {
  day   DateTime @id @db.Date
  count Int
}

model AdminLoginToken {
  hash      Bytes    @id
  expiresAt DateTime
}

model AdminSession {
  hash      Bytes    @id
  expiresAt DateTime
}
