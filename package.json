{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/content build && pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @portfolio/content build && pnpm -r test",
    "typecheck": "pnpm --filter @portfolio/content build && pnpm -r typecheck",
    "lint": "pnpm --filter @portfolio/content build && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-project": "node content/src/cli.ts new",
    "test:e2e": "pnpm --filter @portfolio/content build && pnpm --filter @portfolio/api test:e2e",
    "test:deploy": "bash deploy/deploy.test.sh",
    "eval": "pnpm --filter @portfolio/content build && pnpm --filter @portfolio/api eval",
    "prepare": "husky",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
